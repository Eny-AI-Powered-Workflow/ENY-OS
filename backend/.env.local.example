# /home/obed/Documents/Eny_consulting/Eny_consulting/backend/.env.local.example
# Backend-only local secret; do not copy into frontend environment files.
GHL_INBOUND_WEBHOOK_TOKEN=replace-with-a-long-random-secret
GHL_SYNC_CRON_TOKEN=replace-with-a-different-long-random-secret
GHL_CONTACT_MAX_PAGES=20
GHL_CONTACT_PAGE_SCAN_LIMIT=5
GHL_SYNC_PAGES_PER_RUN=5
GHL_SYNC_LOOKBACK_DAYS=7
# Configure only when requests go through a trusted edge that adds this header.
EDGE_SHARED_SECRET=
# Google OAuth app credentials and token encryption are backend-only.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/v1/calendar/oauth/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_CHAT_SALES_WEBHOOK_URL=
