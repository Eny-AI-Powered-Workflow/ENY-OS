# ENY Consulting backend environment.
# Copy to `.env` and fill in real values: `cp .env.example .env`
# Never commit `.env` to git.

# --- Supabase / database (all required) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_AUDIENCE=authenticated
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# --- Business Support controlled rollout (keep false until staging gates pass) ---
BUSINESS_SUPPORT_ENABLED=false

# --- CORS ---
# Comma-separated list of browser origins allowed to call this API.
BACKEND_CORS_ORIGINS=http://localhost:3000,https://eny-os.vercel.app,https://eny-os.onrender.com
# Optional JSON-array alias. Values are merged with BACKEND_CORS_ORIGINS.
ALLOWED_ORIGINS=["http://localhost:3000"]
# Optional regex for ephemeral preview deployments, e.g. https://eny-.*\.vercel\.app
CORS_ORIGIN_REGEX=

# --- GoHighLevel ---
GHL_PRIVATE_TOKEN=your-ghl-private-integration-token
GHL_LOCATION_ID=your-ghl-location-id
GHL_BASE_URL=https://services.leadconnectorhq.com
GHL_SALES_SCORE_FIELD_ID=your-sales-score-field-id

# --- Customer Success read-only payment visibility (backend only) ---
KAJABI_API_BASE_URL=https://api.kajabi.com
KAJABI_CLIENT_ID=put
KAJABI_CLIENT_SECRET=put
KAJABI_SITE_ID=put
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=put
# Signaturely API access is a separately subscribed plan; read-only contract status only.
SIGNATURELY_API_BASE_URL=https://api.signaturely.com
SIGNATURELY_API_KEY=put
KAJABI_MAX_STUDENT_PAGES=50
CUSTOMER_SUCCESS_SHEETS_SERVICE_ACCOUNT_JSON=put
CUSTOMER_SUCCESS_PROGRAM_SHEET_ID=put
CUSTOMER_SUCCESS_PROGRAM_SHEET_RANGE=
CUSTOMER_SUCCESS_PROGRAM_SHEET_MAX_ROWS=5000

## How do I find the field IDs for GHL?
# 1. Log in to your GHL account.
# 2. Navigate to "Settings" > "Custom Fields".
GHL_SCORE_CATEGORY_FIELD_ID=CiowYO5hnAmwWKCp7vAO
GHL_ENROLLMENT_STATUS_FIELD_ID=OuRGORJLJYHMOXNlhAcH
GHL_CONTACT_MAX_PAGES=20
GHL_NOTIFICATION_FROM_EMAIL=verified-sender@example.com
GHL_MARKETING_FROM_EMAIL=verified-marketing-sender@example.com
GHL_MARKETING_FROM_NAME=ENY Consulting
GHL_MARKETING_LOCATION_ID=
# GHL custom field containing explicit marketing opt-in (accepted values: true, yes, 1, subscribed, opted_in).
GHL_MARKETING_CONSENT_FIELD_ID=

# --- Marketing social publishing (backend only; Buffer is the initial provider) ---
BUFFER_ACCESS_TOKEN=
BUFFER_PROFILE_IDS=

# --- Marketing SEO and social intelligence (backend only) ---
# Store service-account JSON as a secret-manager value, not in source control.
GSC_SERVICE_ACCOUNT_JSON=
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=
AHREFS_API_KEY=
SEMRUSH_API_KEY=
PAGESPEED_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SERPAPI_API_KEY=
LINKEDIN_ACCESS_TOKEN=
META_ACCESS_TOKEN=
X_BEARER_TOKEN=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
SLACK_BOT_TOKEN=
SUPABASE_MARKETING_VIDEO_BUCKET=marketing-video
MARKETING_VIDEO_MAX_UPLOAD_MB=250
FFMPEG_PATH=ffmpeg
# Canva is an optional OAuth integration. Keep credentials backend-only.
CANVA_ACCESS_TOKEN=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
MARKETING_APPROVAL_SLA_HOURS=72
MARKETING_LOW_PERFORMANCE_DROP_PCT=30
MARKETING_UNSUBSCRIBE_ALERT_RATE=2.0
SUPABASE_DESIGN_ASSET_BUCKET=design-assets
DESIGN_ASSET_MAX_UPLOAD_MB=50

# --- Graphic Designer Phase 5/6 providers (backend only) ---
# Canva Connect OAuth: register the exact HTTPS redirect URI and the listed scopes in Canva Developers.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=
CANVA_POST_CONNECT_REDIRECT=http://localhost:3000/dashboard/designer
# Generate a Fernet key for encrypting Canva access/refresh tokens at rest; do not reuse the Supabase key.
CANVA_TOKEN_ENCRYPTION_KEY=
CANVA_OAUTH_SCOPES=brandtemplate:content:read design:content:write design:meta:read design:content:read
# Webflow v2 CMS publishing adapter; create a token with CMS write and site publish scopes.
WEBFLOW_ACCESS_TOKEN=
WEBFLOW_SITE_ID=
WEBFLOW_CMS_COLLECTION_ID=
WEBFLOW_PUBLIC_BASE_URL=
WEBFLOW_PUBLISH_TO_SUBDOMAIN=false

# --- n8n workflows ---
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
N8N_WEBHOOK_TOKEN=replace-with-a-dedicated-webhook-secret
N8N_MOCK_MODE=false

# --- Executive Assistant provider adapters (backend only) ---
EA_CALENDAR_BASE_URL=
EA_CALENDAR_TOKEN=
EA_CALENDAR_PATH=events
EA_TASKS_BASE_URL=
EA_TASKS_TOKEN=
EA_TASKS_PATH=tasks

# --- Anthropic (AI Desk) ---
ANTHROPIC_API_KEY=sk-ant-xxxx
CLAUDE_MODEL=claude-sonnet-5

# --- OpenAI embeddings (SOP knowledge ingest) ---
# Leave OPENAI_API_KEY empty to disable vector knowledge; retrieval falls back to
# full-text search and knowledge ingest returns HTTP 503.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Chunks are embedded in batches to keep requests efficient, but a live product
# must fail fast on OpenAI HTTP 429s instead of blocking the API during retries.
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=0
EMBEDDING_RETRY_BASE_SECONDS=1.0
EMBEDDING_RETRY_MAX_SECONDS=20.0
EMBEDDING_TIMEOUT_SECONDS=60.0
# Maximum number of chunks a single SOP upload may produce (HTTP 413 above this).
KNOWLEDGE_MAX_CHUNKS=400

# --- Batch scoring retries ---
BATCH_MAX_RETRIES=3
BATCH_RETRY_BACKOFF_SECONDS=60

# --- Optional research APIs ---
APOLLO_API_KEY=
PERPLEXITY_API_KEY=

# --- Server ---
HOST=0.0.0.0
PORT=8000
